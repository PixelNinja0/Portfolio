---
interface Props {
  number: string;
  label: string;
  title: string;
}
const { number, label, title } = Astro.props;
---
<div class="flex flex-col gap-8">
  <span class="font-body font-medium text-[11px] tracking-[0.88px] text-text-light uppercase">{number} - {label}</span>
  <h2 class="font-heading font-semibold text-[24px] md:text-[32px] leading-tight tracking-[-0.64px] text-text-900">
    {title}
  </h2>
</div>
