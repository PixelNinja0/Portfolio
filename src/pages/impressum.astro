---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impressum — Liam Dahl">
  <section class="px-20 py-80 md:px-80 md:py-100">
    <div class="max-w-[720px]">

      <h1 class="font-heading font-semibold text-[28px] leading-[34px] tracking-[-0.56px] md:text-[40px] md:leading-[46px] md:tracking-[-0.8px] text-text-900 mb-48 md:mb-64">
        Impressum
      </h1>

      <div class="flex flex-col gap-40 md:gap-48 font-body text-[15px] leading-26 text-text-900">

        <div class="flex flex-col gap-8">
          <h2 class="font-heading font-semibold text-[14px] leading-20 tracking-[0.5px] uppercase text-text-light">
            Angaben gemäß § 5 TMG
          </h2>
          <p>Liam Dahl</p>
          <p>Theodor-Heuss-Straße 26<br />85055 Ingolstadt</p>
        </div>

        <div class="flex flex-col gap-8">
          <h2 class="font-heading font-semibold text-[14px] leading-20 tracking-[0.5px] uppercase text-text-light">
            Kontakt
          </h2>
          <p>
            E-Mail:&nbsp;
            <a href="mailto:Liam.dhl@proton.me" class="text-primary-600 hover:opacity-80 transition-opacity">
              Liam.dhl@proton.me
            </a>
          </p>
        </div>

        <div class="flex flex-col gap-8">
          <h2 class="font-heading font-semibold text-[14px] leading-20 tracking-[0.5px] uppercase text-text-light">
            Hinweis
          </h2>
          <p>
            Diese Website dient als persönliches Portfolio und wird nicht zu gewerblichen Zwecken betrieben.
          </p>
        </div>

      </div>
    </div>
  </section>
</Layout>
