---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import imgHeroVisual from '../../assets/images/ai-pdf-Mockup.png';
import imgPoster from '../../assets/images/Posterpdf.png';
import imgWorkflow from '../../assets/images/Workflow_PDF.png';
import imgScreen from '../../assets/images/Screenpdf.png';

const sliderImages = [
  { src: imgPoster.src, alt: 'Accessible PDF Reader – Poster' },
  { src: imgWorkflow.src, alt: 'Accessible PDF Reader – Workflow' },
  { src: imgScreen.src, alt: 'Accessible PDF Reader – Screen' },
];

const ablaufSteps = [
  { number: '01', title: 'Kontext Definition', description: 'Nutzergruppe definiert, erste Ideen entwickelt.' },
  { number: '02', title: 'Nutzungskontextanalyse', description: 'Interviews durchgeführt, Persona erstellt, User Storys & Aufgabenmodelle erstellt.' },
  { number: '03', title: 'Anforderungsermittlung', description: 'Erfordernisse aus Nutzungskontextanalyse in Anforderungen formuliert.' },
  { number: '04', title: 'Informationsarchitektur', description: 'Navigationsstruktur, Skizzen, Aufgabenobjekte & Attribute erstellt.' },
  { number: '05', title: 'Interaktionsdesign', description: 'Wireframes und Low-Fidelity-Skizzen der Zustände erstellt.' },
  { number: '06', title: 'Interface Design', description: 'High-Fidelity-Prototyp erstellt.' },
  { number: '07', title: 'Frontend', description: 'HTML/CSS/JS umgesetzt, mit Fokus auf Screenreader-Zugänglichkeit.' },
  { number: '08', title: 'Test & Betrieb', description: 'End-to-End getestet und auf Render deployt.' },
  { number: '09', title: 'Dokumentation & Präsentation', description: 'Dokumentation erstellt, Präsentation erstellt.' },
];
---

<Layout
  title="Accessible PDF Reader | Liam Dahl"
  description="Case Study: PDF-Reader für blinde und sehbehinderte Nutzer. Screenreader-first konzipiert, mit Fokus-Management und getesteter Informationsarchitektur."
>
  <div class="flex flex-col md:flex-row md:items-start mx-20 md:mx-80 py-40 md:py-64 gap-40 md:gap-48">

    <!-- Side Nav (Desktop only) -->
    <aside class="hidden md:block sticky top-139 shrink-0 w-240 border border-border rounded-lg px-24 py-32 self-start">
      <span class="block font-body font-medium text-[11px] tracking-[0.88px] text-text-light mb-24">CASE STUDY</span>
      <nav class="flex flex-col gap-8">
        <a href="#ueberblick" data-section="ueberblick" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">01 – Überblick</span>
        </a>
        <a href="#vorgehen" data-section="vorgehen" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">02 – Vorgehen</span>
        </a>
        <a href="#system" data-section="system" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">03 – System</span>
        </a>
        <a href="#test" data-section="test" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">04 – Test & Betrieb</span>
        </a>
        <a href="#details" data-section="details" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">05 – Details</span>
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col gap-64 min-w-0">

      <!-- 01 Überblick -->
      <section id="ueberblick" class="flex flex-col gap-64">

        <!-- Hero Row -->
        <div class="flex flex-col md:flex-row md:gap-80 md:items-center gap-32">
          <div class="flex flex-col gap-40 md:flex-1">
            <div class="flex flex-col gap-32">
              <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ENGINEERING · ACCESSIBILITY · 2025</span>
              <h1 class="font-heading font-semibold text-[30px] md:text-[48px] text-text-900 leading-tight tracking-[-0.9px] md:tracking-[-1.44px]">Accessible PDF Reader</h1>
              <div class="flex flex-col gap-24">
                <p class="font-heading font-medium text-[22px] md:text-[28px] text-text-900 leading-snug tracking-[-0.28px]">Eine Web-App, die PDFs per Frage beantwortet — mit Barrierefreiheit als Fundament.</p>
                <p class="font-body text-[16px] leading-26 text-text-light">PDF hochladen, eine Frage zum Dokument stellen, die Antwort bei Bedarf vorlesen lassen. Konzipiert von der schwierigsten Nutzung her gedacht — blinde Screenreader-Nutzer — und durchgehend barrierefrei umgesetzt.</p>
              </div>
            </div>
            <div class="flex gap-20 items-center flex-wrap">
              <Button label="Live Demo sehen" href="https://ai-pdf-reader-q2qy.onrender.com" variant="primary" />
              <Button label="GitHub" href="https://github.com/PixelNinja0/ai-pdf-reader" variant="secondary" />
            </div>
          </div>
          <!-- Hero Visual -->
          <div class="w-full h-332 md:w-447 md:h-420 bg-border rounded-[18px] shrink-0 overflow-hidden flex items-center justify-center">
            <img src={imgHeroVisual.src} alt="Accessible PDF Reader App Mockup" class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Meta Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-16 md:gap-24">
          <div class="border border-border rounded-lg p-16 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ROLLE</span>
            <p class="font-body text-[16px] leading-26 text-text-light">Konzept · Architektur · Frontend · Accessibility</p>
          </div>
          <div class="border border-border rounded-lg p-16 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ZEITRAUM</span>
            <p class="font-body text-[16px] leading-26 text-text-light">2025</p>
          </div>
          <div class="border border-border rounded-lg p-16 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">TOOLS</span>
            <p class="font-body text-[16px] leading-26 text-text-light">Python · FastAPI · OpenAI (gpt-4.1-nano) · pypdf · HTML/CSS/JS</p>
          </div>
          <div class="border border-border rounded-lg p-16 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">METHODEN</span>
            <p class="font-body text-[16px] leading-26 text-text-light">Screenreader-Test (NVDA)</p>
          </div>
        </div>

        <SectionEyebrow number="01" label="Überblick" title="Was für ein Projekt ist es überhaupt" />

        <!-- Überblick Card -->
        <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
          <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ÜBERBLICK</span>
          <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">Ein Dokument befragen, statt es durchzulesen</p>
          <p class="font-body text-[16px] leading-26 text-text-light">Eine kleine, fokussierte Anwendung: Dokument hochladen, befragen, vorlesen. Dahinter eine bewusst entkoppelte Architektur – fünf Module, jede Datei mit einer Aufgabe. Zwei Entscheidungen prägen das Projekt: eine klar definierte Naht für späteres RAG und eine Barrierefreiheit, die von der blinden Nutzung her gedacht ist statt nachträglich aufgesetzt.</p>
        </div>
      </section>

      <!-- 02 Vorgehen -->
      <section id="vorgehen" class="flex flex-col gap-64 border-t border-border pt-64">
        <SectionEyebrow number="02" label="Vorgehen" title="Ablauf des Projekts" />

        <div class="flex flex-col border border-border rounded-lg divide-y divide-border">
          {ablaufSteps.map((step) => (
            <div class="flex flex-col md:flex-row md:items-baseline gap-8 md:gap-24 p-20 md:px-32 md:py-24">
              <span class="font-body font-semibold text-[13px] text-primary-600 md:w-40 shrink-0">{step.number}</span>
              <span class="font-heading font-semibold text-[15px] md:text-[16px] text-text-900 md:w-220 shrink-0">{step.title}</span>
              <span class="font-body text-[14px] md:text-[15px] leading-24 text-text-light">{step.description}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 03 System -->
      <section id="system" class="flex flex-col gap-48 border-t border-border pt-64">
        <SectionEyebrow number="03" label="System" title="Bild für dich" />

        <div class="flex flex-col gap-24">
          <div class="relative overflow-hidden rounded-xl bg-border" id="slider">
            <div class="flex transition-transform duration-400 ease-in-out" id="slider-track">
              {sliderImages.map((img) => (
                <div class="min-w-full">
                  <img src={img.src} alt={img.alt} class="w-full h-420 md:h-640 object-contain" />
                </div>
              ))}
            </div>
          </div>
          <!-- Prev / Dots / Next -->
          <div class="flex items-center justify-center gap-16">
            <button id="slider-prev" aria-label="Vorheriges Bild" class="shrink-0 w-40 h-40 bg-background border border-border rounded-full flex items-center justify-center text-text-900 hover:bg-border transition-colors">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="flex justify-center gap-8" id="slider-dots">
              {sliderImages.map((_, i) => (
                <button
                  class={`slider-dot w-8 h-8 rounded-full border border-border transition-colors ${i === 0 ? 'bg-text-900' : 'bg-border'}`}
                  data-index={i}
                  aria-label={`Bild ${i + 1}`}
                />
              ))}
            </div>
            <button id="slider-next" aria-label="Nächstes Bild" class="shrink-0 w-40 h-40 bg-background border border-border rounded-full flex items-center justify-center text-text-900 hover:bg-border transition-colors">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>

        <!-- Barrierefreiheit Entscheidungen -->
        <div class="flex flex-row overflow-x-auto snap-x snap-mandatory scrollbar-hide gap-16 pb-1 [&>*]:w-[80%] [&>*]:shrink-0 [&>*]:snap-start md:grid md:grid-cols-3 md:overflow-visible md:pb-0 md:gap-24 md:[&>*]:min-w-0 md:[&>*]:w-auto">
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">AUDIO</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">Vorlesen bewusst degradiert</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Für Screenreader-Nutzer redundant – ihre Software liest selbst. Der Vorlesen-Button ist auf Seh- und Leseschwäche zugeschnitten: nur manueller Start, nie Auto-Play – sonst doppelte Stimme.</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">FOKUS</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">Antwort = Hinspringen</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Kommt die Antwort, springt der Fokus direkt hinein – und sie wird nicht zusätzlich per Live-Region angesagt. Beides zusammen würde sie doppelt vorlesen.</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ANSAGEN</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">Live-Regionen nach Dringlichkeit</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Verlauf höflich (role=log), Fehler bestimmt (role=alert). Während der KI-Latenz hält „Antwort wird erstellt…" die Stille auf; Senden ist solange gesperrt.</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">DIALOG</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">PDF wechseln nur mit Bestätigung</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Modaler Dialog mit Fokus-Falle, Esc bricht ab, der Fokus kehrt zurück. Bei „Laden": Verlauf leeren, Fokus auf die Empty-State-Überschrift.</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">STRUKTUR</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">Semantik als Fundament</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Semantisches HTML, Landmarks, Skip-Link, ein Label an jedem Feld, sichtbare Fokusringe – und Farbe ist nie der alleinige Bedeutungsträger.</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ROBUST</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">Für alle nutzbar</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Touch-Ziele ≥ 44px, Reflow bis 320px und 200% Zoom, prefers-reduced-motion respektiert, fetch statt Reload für nahtlose Updates.</p>
          </div>
        </div>
      </section>

      <!-- 04 Test & Betrieb -->
      <section id="test" class="flex flex-col gap-32 border-t border-border pt-64">
        <SectionEyebrow number="04" label="Test & Betrieb" title="End-to-End mit einer Test-PDF geprüft" />

        <div class="grid grid-cols-2 md:grid-cols-4 gap-16 md:gap-24">
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-8">
            <p class="font-heading font-bold text-[40px] md:text-[48px] text-text-900 leading-none">4/4</p>
            <p class="font-body font-medium text-[13px] text-text-light">Testfälle bestanden</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-8">
            <p class="font-heading font-bold text-[40px] md:text-[48px] text-text-900 leading-none">5</p>
            <p class="font-body font-medium text-[13px] text-text-light">entkoppelte Module</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-8">
            <p class="font-heading font-bold text-[40px] md:text-[48px] text-text-900 leading-none">100 %</p>
            <p class="font-body font-medium text-[13px] text-text-light">Antworten dokumentbasiert</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-8">
            <p class="font-heading font-bold text-[40px] md:text-[48px] text-text-900 leading-none">0</p>
            <p class="font-body font-medium text-[13px] text-text-light">Halluzinationen im Test</p>
          </div>
        </div>

        <!-- Vorgehen -->
        <div class="flex flex-col gap-32">
          <div class="flex flex-col gap-8 md:gap-16">
            <h3 class="font-heading font-medium text-[22px] md:text-[28px] text-text-900 leading-snug tracking-[-0.28px]">Wie getestet wurde</h3>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <p class="font-body text-[16px] leading-26 text-text-light">Geprüft wurde auf vier Dinge: korrekte Fakten, korrekte Details, sauberes Abweisen einer Frage ohne Antwort im Dokument, und deutsches Vorlesen per Web Speech API.</p>
          </div>
        </div>
      </section>

      <!-- 05 Details -->
      <section id="details" class="flex flex-col gap-64 border-t border-border pt-64">
        <SectionEyebrow number="05" label="Details" title="Zusammenfassung und Projektdetails zum nachschauen" />

        <!-- Result Card -->
        <div class="border border-border rounded-lg p-24 md:p-48 flex flex-col gap-32 md:gap-40">
          <div class="flex flex-col gap-8 md:gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ERGEBNIS</span>
            <div class="flex flex-col gap-24">
              <h3 class="font-heading font-medium text-[22px] md:text-[28px] text-text-900 leading-snug tracking-[-0.28px]">Eine lauffähige, barrierefreie App – sauber gebaut</h3>
              <p class="font-body text-[16px] leading-26 text-text-light">PDF hochladen, befragen, vorlesen. End-to-End getestet, deployt, mit einer Architektur, die für RAG vorbereitet ist. Das System antwortet nur auf Basis des Dokuments – und sagt ehrlich, wenn etwas fehlt.</p>
            </div>
          </div>
          <div class="flex gap-16 md:gap-32 items-center flex-wrap">
            <Button label="Live Demo ansehen" href="https://ai-pdf-reader-q2qy.onrender.com" variant="primary" />
            <Button label="Projekt Details ansehen" href="#" variant="secondary" />
            <Button label="GitHub Repository" href="https://github.com/PixelNinja0/ai-pdf-reader" variant="secondary" />
          </div>
        </div>
      </section>

    </main>
  </div>

  <script>
    const sideLinks = document.querySelectorAll<HTMLAnchorElement>('.side-nav-link');
    const sections = document.querySelectorAll<HTMLElement>('section[id]');

    function setSideActive(id: string) {
      sideLinks.forEach((link) => {
        const isActive = link.dataset.section === id;
        const bar = link.querySelector<HTMLElement>('[data-bar]');
        const text = link.querySelector<HTMLElement>('[data-text]');
        if (bar) {
          bar.classList.toggle('w-20', isActive);
          bar.classList.toggle('w-4', !isActive);
          bar.classList.toggle('bg-primary-600', isActive);
          bar.classList.toggle('bg-text-light', !isActive);
        }
        if (text) {
          text.classList.toggle('font-semibold', isActive);
          text.classList.toggle('font-normal', !isActive);
          text.classList.toggle('text-primary-600', isActive);
          text.classList.toggle('text-text-light', !isActive);
        }
      });
    }

    if (sections.length > 0 && sideLinks.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) setSideActive((entry.target as HTMLElement).id);
          });
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
      );
      sections.forEach((s) => observer.observe(s));
      setSideActive('ueberblick');
    }

    // Picture Slider
    const track = document.getElementById('slider-track') as HTMLElement | null;
    const dots = document.querySelectorAll<HTMLButtonElement>('.slider-dot');
    const total = dots.length;
    let current = 0;

    function goTo(index: number) {
      current = (index + total) % total;
      if (track) track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-text-900', i === current);
        dot.classList.toggle('bg-border', i !== current);
      });
    }

    document.getElementById('slider-prev')?.addEventListener('click', () => goTo(current - 1));
    document.getElementById('slider-next')?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Touch swipe
    let touchStartX = 0;
    const sliderEl = document.getElementById('slider');
    sliderEl?.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    sliderEl?.addEventListener('touchend', (e) => {
      const delta = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(delta) > 40) goTo(delta > 0 ? current + 1 : current - 1);
    });
  </script>
</Layout>
