  <script>
    const sideLinks = document.querySelectorAll<HTMLAnchorElement>('.side-nav-link');
    const sections = document.querySelectorAll<HTMLElement>('section[id]');

    function setSideActive(id: string) {
      sideLinks.forEach((link) => {
        const isActive = link.dataset.section === id;
        const bar = link.querySelector<HTMLElement>('[data-bar]');
        const text = link.querySelector<HTMLElement>('[data-text]');
        if (bar) {
          bar.classList.toggle('w-20', isActive);
          bar.classList.toggle('w-4', !isActive);
          bar.classList.toggle('bg-primary-600', isActive);
          bar.classList.toggle('bg-text-light', !isActive);
        }
        if (text) {
          text.classList.toggle('font-semibold', isActive);
          text.classList.toggle('font-normal', !isActive);
          text.classList.toggle('text-primary-600', isActive);
          text.classList.toggle('text-text-light', !isActive);
        }
      });
    }

    if (sections.length > 0 && sideLinks.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) setSideActive((entry.target as HTMLElement).id);
          });
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
      );
      sections.forEach((s) => observer.observe(s));
      setSideActive('ueberblick');
    }
  </script>
