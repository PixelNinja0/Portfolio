---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';

import mockupHero from '../../assets/images/MockupBuchung.png';
import imgGascontroll1 from '../../assets/images/Gascontroll1.png';
import imgGascontroll2 from '../../assets/images/Gascontroll2.png';
import imgGascontroll3 from '../../assets/images/Gascontroll3.png';
import imgGascontroll4 from '../../assets/images/Gascontroll4.png';
import imgWaermecheck1 from '../../assets/images/Waermecheck1.png';
import imgWaermecheck2 from '../../assets/images/Waermecheck2.png';
import imgWaermecheck3 from '../../assets/images/Waermecheck3.png';
import imgWaermecheck4 from '../../assets/images/Waermecheck4.png';
import imgWaermecheck5 from '../../assets/images/Waermecheck5.png';

const ablaufSteps = [
  { number: '01', title: 'Kontext Definition', description: 'Unternehmen analysiert, Nutzergruppe definiert.' },
  { number: '02', title: 'Anforderungsermittlung', description: 'Interviews durchgeführt, Persona erstellt, User Storys & Aufgabenmodelle erstellt.' },
  { number: '03', title: 'Systemanalyse', description: 'Mit 10 Nielsen-Heuristiken Buchungstool analysiert, Bug-Findings dokumentiert.' },
  { number: '04', title: 'Anforderungsspezifikation', description: 'Erfordernisse aus Nutzer & Konzept sowie Systemanalyse in Nutzeranforderungen abgeleitet.' },
  { number: '05', title: 'Prototyping', description: 'Wireframes, dann Low-, Mid- und High-Fidelity-Mockups erstellt.' },
  { number: '06', title: 'Formativer Usability-Test', description: 'Formativ wurde ein Usability-Test mit 4 Probanden zum Testen des Systems durchgeführt.' },
  { number: '07', title: 'Software-Integration', description: 'Figma-Prototyp als Tailwind-CSS-Datei angelegt und live gegangen.' },
  { number: '08', title: 'Summativer Usability-Test', description: 'Weiterer Usability-Test mit bestehendem System durchgeführt. n = 6. Effektivität, Effizienz, SUS.' },
  { number: '09', title: 'Dokumentation & Integration', description: 'Markdown-Dokumentation in Obsidian angelegt, Website live gebracht, Projekt-Reflexion. Ende.' },
];

const systemSlides = [
  { original: imgGascontroll1.src, neu: imgWaermecheck1.src },
  { original: imgGascontroll2.src, neu: imgWaermecheck2.src },
  { original: imgGascontroll3.src, neu: imgWaermecheck3.src },
  { original: imgGascontroll4.src, neu: imgWaermecheck4.src },
  { original: null, neu: imgWaermecheck5.src },
];

const metrics = [
  { label: 'Effektivität', description: 'Aufgaben erfolgreich abgeschlossen.', oldDisplay: '82%', oldPct: 82, newDisplay: '100%', newPct: 100 },
  { label: 'Effizienz', description: 'Zeit bis zur abgeschlossenen Buchung.', oldDisplay: '3:12', oldPct: 100, newDisplay: '1:46', newPct: 55 },
  { label: 'Nutzererlebnis', description: 'Ergibt sich aus dem SUS Score.', oldDisplay: '62', oldPct: 62, newDisplay: '82', newPct: 82 },
];
---

<Layout
  title="WärmeCheck – Buchungssystem Redesign | Liam Dahl"
  description="Case Study: Heuristische Evaluation nach Nielsen, 3 funktionale Bugs und 10 UX-Probleme identifiziert, Redesign konzipiert und im Usability-Test validiert. Mit Live-Demo."
>
  <div class="flex flex-col md:flex-row md:items-start mx-20 md:mx-80 py-40 md:py-64 gap-40 md:gap-48">

    <!-- Side Nav (Desktop only) -->
    <aside class="hidden md:block sticky top-139 shrink-0 w-240 border border-border rounded-lg px-24 py-32 self-start">
      <span class="block font-body font-medium text-[11px] tracking-[0.88px] text-text-light mb-24">CASE STUDY</span>
      <nav class="flex flex-col gap-8">
        <a href="#ueberblick" data-section="ueberblick" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">01 – Überblick</span>
        </a>
        <a href="#vorgehen" data-section="vorgehen" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">02 – Vorgehen</span>
        </a>
        <a href="#system" data-section="system" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">03 – System</span>
        </a>
        <a href="#ergebnisse" data-section="ergebnisse" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">04 – Ergebnisse</span>
        </a>
        <a href="#details" data-section="details" class="side-nav-link flex items-center gap-12 py-8">
          <span data-bar class="block h-2 w-4 bg-text-light rounded-full transition-all duration-200"></span>
          <span data-text class="font-body font-normal text-[14px] text-text-light transition-colors duration-200">05 – Details</span>
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col gap-80 min-w-0">

      <!-- 01 Überblick -->
      <section id="ueberblick" class="flex flex-col gap-64">

        <!-- Hero Row: text left + visual right on desktop -->
        <div class="flex flex-col md:flex-row md:gap-80 md:items-center gap-32">
          <div class="flex flex-col gap-40 md:flex-1">
            <div class="flex flex-col gap-32">
              <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">USABILITY-TEST · UX-KONZEPT · 2026</span>
              <h1 class="font-heading font-semibold text-[30px] md:text-[48px] text-text-900 leading-tight tracking-[-0.9px] md:tracking-[-1.44px]">WärmeCheck</h1>
              <div class="flex flex-col gap-24">
                <p class="font-heading font-medium text-[22px] md:text-[28px] text-text-900 leading-snug tracking-[-0.28px]">Redesign eines Heizungswartungs-Buchungssystems</p>
                <p class="font-body text-[16px] leading-26 text-text-light">Ein generisches SaaS-Buchungstool ersetzt durch eine branchenspezifische, nutzerorientierte Buchungsstrecke – konzipiert, getestet und umgesetzt in 9 Phasen.</p>
              </div>
            </div>
            <div class="flex gap-20 items-center flex-wrap">
              <Button label="Live Demo sehen" href="https://pixelninja0.github.io/waermecheck-buchung/" variant="primary" />
              <Button label="GitHub" href="https://github.com/PixelNinja0" variant="secondary" />
            </div>
          </div>
          <!-- Hero Visual -->
          <div class="w-full h-332 md:w-447 md:h-420 bg-border rounded-[18px] shrink-0 overflow-hidden">
            <img src={mockupHero.src} alt="WärmeCheck Buchungssystem Mockup" class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Meta Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-16 md:gap-24">
          <div class="border border-border rounded-lg p-16 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ROLLE</span>
            <p class="font-body text-[16px] leading-26 text-text-light">UX Research, Interaction Design, Frontend</p>
          </div>
          <div class="border border-border rounded-lg p-16 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ZEITRAUM</span>
            <p class="font-body text-[16px] leading-26 text-text-light">2026</p>
          </div>
          <div class="border border-border rounded-lg p-16 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">TOOLS</span>
            <p class="font-body text-[16px] leading-26 text-text-light">Figma, HTML, Tailwind CSS, Obsidian</p>
          </div>
          <div class="border border-border rounded-lg p-16 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">METHODEN</span>
            <p class="font-body text-[16px] leading-26 text-text-light">Heuristik, Usability-Test, Iteration</p>
          </div>
        </div>

        <SectionEyebrow number="01" label="Überblick" title="Was für ein Projekt ist es überhaupt" />

        <!-- Projektübersicht Card -->
        <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
          <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">Projektübersicht</span>
          <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">Von generisch zu branchenspezifisch – ein Buchungssystem neu gedacht</p>
          <p class="font-body text-[16px] leading-26 text-text-light">Im Rahmen einer Konzeptstudie habe ich das Buchungssystem eines Hamburger Heizungsfachbetriebs (GasControl) analysiert und unter dem Projektnamen WärmeCheck neu konzipiert. Das genutzte generische SaaS-Buchungstool befolgte keine UX- und UI-Richtlinien, was zu Verwirrung, Fehlern und potenziellen Abbrüchen führte. Im Rahmen der Analyse habe ich 3 funktionale Bugs und mithilfe der Nielsen-Heuristiken 10 UX-Probleme identifiziert. Auf Basis einer Persona und einem klaren Nutzerfluss habe ich ein branchenspezifisches Redesign entwickelt, das in einem Usability-Test mit 4 Probanden getestet.</p>
        </div>
      </section>

      <!-- 02 Vorgehen -->
      <section id="vorgehen" class="flex flex-col gap-64 border-t border-border pt-64">
        <SectionEyebrow number="02" label="Vorgehen" title="Ablauf des Projekts" />

        <div class="flex flex-col border border-border rounded-lg divide-y divide-border">
          {ablaufSteps.map((step) => (
            <div class="flex flex-col md:flex-row md:items-baseline gap-8 md:gap-24 p-20 md:px-32 md:py-24">
              <span class="font-body font-semibold text-[13px] text-primary-600 md:w-40 shrink-0">{step.number}</span>
              <span class="font-heading font-semibold text-[15px] md:text-[16px] text-text-900 md:w-220 shrink-0">{step.title}</span>
              <span class="font-body text-[14px] md:text-[15px] leading-24 text-text-light">{step.description}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 03 System -->
      <section id="system" class="flex flex-col gap-48 border-t border-border pt-64">
        <SectionEyebrow number="03" label="System" title="Vergleich altes System mit Neuem" />

        <div class="flex flex-col gap-24">
          <div class="grid grid-cols-2 gap-16 md:gap-24">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">Original System</span>
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">Neues System</span>
          </div>

          <div id="system-slides">
            {systemSlides.map((slide, i) => (
              <div class="system-slide grid grid-cols-2 gap-16 md:gap-24" data-slide={i} hidden={i !== 0}>
                {slide.original ? (
                  <div class="w-full h-420 md:h-560 bg-border rounded-lg overflow-hidden flex items-center justify-center p-16">
                    <img src={slide.original} alt={`Original System – Screen ${i + 1}`} class="w-full h-full object-contain" />
                  </div>
                ) : (
                  <div class="w-full h-420 md:h-560 bg-border rounded-lg flex items-center justify-center px-24 text-center">
                    <span class="font-body text-[13px] md:text-[14px] text-text-light">Diesen Screen gibt es im Original-System nicht.</span>
                  </div>
                )}
                <div class="w-full h-420 md:h-560 bg-border rounded-lg overflow-hidden flex items-center justify-center p-16">
                  <img src={slide.neu} alt={`Neues System – Screen ${i + 1}`} class="w-full h-full object-contain" />
                </div>
              </div>
            ))}
          </div>

          <div class="flex flex-col items-center gap-8">
            <div class="flex items-center gap-16">
              <button
                id="system-slide-prev"
                aria-label="Vorheriger Vergleich"
                class="w-40 h-40 rounded-full border border-border bg-background flex items-center justify-center hover:border-primary-500 transition-colors"
              >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button
                id="system-slide-next"
                aria-label="Nächster Vergleich"
                class="w-40 h-40 rounded-full border border-border bg-background flex items-center justify-center hover:border-primary-500 transition-colors"
              >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
            <span id="system-slide-counter" class="font-body text-[12px] text-text-light">1 / 5</span>
          </div>
        </div>

        <!-- Fixes -->
        <div class="flex flex-row overflow-x-auto snap-x snap-mandatory scrollbar-hide gap-16 pb-1 [&>*]:w-[80%] [&>*]:shrink-0 [&>*]:snap-start md:grid md:grid-cols-2 md:overflow-visible md:pb-0 md:gap-24 md:[&>*]:min-w-0 md:[&>*]:w-auto">
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">FIX 01</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">PLZ/Ort-Inkonsistenz behoben</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Placeholder und Überschrift angeglichen. Das Feld akzeptiert jetzt explizit beides – PLZ oder Ortsname.</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">FIX 02</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">kW-Hinweis prominenter</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Hinweis „Die kW-Zahl steht auf dem Typenschild" um eine Analogie ergänzt. „Weiß ich nicht"-Option visuell hervorgehoben.</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">FIX 03</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">Hersteller-Auswahl umsortiert</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Die „Ich bin unsicher"-Option als erste Option in der Liste platziert – ältere Probanden hatten sie am Ende übersehen.</p>
          </div>
          <div class="border border-border rounded-lg p-24 md:p-32 flex flex-col gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">FIX 04</span>
            <p class="font-heading font-semibold text-[18px] md:text-[26px] text-text-900 leading-snug tracking-normal">Datum-Hinweis ergänzt</p>
            <p class="font-body text-[16px] leading-26 text-text-light">Zeitslots sind erst sichtbar, nachdem ein Datum gewählt wurde – mit klarem Hinweis „Bitte wählen Sie zuerst ein Datum".</p>
          </div>
        </div>
      </section>

      <!-- 04 Ergebnisse -->
      <section id="ergebnisse" class="flex flex-col gap-32 border-t border-border pt-64">
        <SectionEyebrow number="04" label="Ergebnisse" title="Zahlen aus der Summative Usability Studie" />

        <div class="border border-border rounded-lg flex flex-col">
          <div class="flex flex-col gap-16 p-24 md:p-32">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">SUMMATIVE USABILITY STUDIE</span>
            <h3 class="font-heading font-semibold text-[20px] md:text-[24px] text-text-900">Gemessene Werte</h3>
            <p class="font-body text-[16px] leading-26 text-text-light">Beide Systeme wurden mit denselben Aufgaben getestet, das alte Buchungstool und WärmeCheck. Verglichen entlang der drei Dimensionen von Gebrauchstauglichkeit.</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-32 border-t border-border p-24 md:p-32">
            {metrics.map((m) => (
              <div class="flex flex-col gap-16">
                <div>
                  <h4 class="font-heading font-semibold text-[16px] text-text-900">{m.label}</h4>
                  <p class="font-body text-[13px] text-text-light">{m.description}</p>
                </div>
                <div class="flex flex-col gap-8">
                  <div class="flex flex-col gap-4">
                    <div class="flex justify-between font-body text-[12px] text-text-light">
                      <span>Altes System</span><span>{m.oldDisplay}</span>
                    </div>
                    <div class="h-8 rounded-full bg-border overflow-hidden">
                      <div class="h-full bg-text-900 rounded-full" style={`width:${m.oldPct}%`}></div>
                    </div>
                  </div>
                  <div class="flex flex-col gap-4">
                    <div class="flex justify-between font-body text-[12px] text-text-light">
                      <span>neues System</span><span>{m.newDisplay}</span>
                    </div>
                    <div class="h-8 rounded-full bg-border overflow-hidden">
                      <div class="h-full bg-primary-600 rounded-full" style={`width:${m.newPct}%`}></div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <p class="font-body text-[13px] leading-22 text-text-light">Summative Studie, 6 Teilnehmende, identische Aufgabenstellung an beiden Systemen. Dimensionen nach ISO 9241-11. Bei dieser Stichprobengröße sind die Werte als Richtung zu lesen, nicht als statistischer Nachweis. Studiendesign und Rohdaten im PDF.</p>
      </section>

      <!-- 05 Details -->
      <section id="details" class="flex flex-col gap-64 border-t border-border pt-64">
        <SectionEyebrow number="05" label="Details" title="Zusammenfassung und Projektdetails zum nachschauen" />

        <!-- Result Card -->
        <div class="border border-border rounded-lg p-24 md:p-48 flex flex-col gap-32 md:gap-40">
          <div class="flex flex-col gap-8 md:gap-16">
            <span class="font-body font-medium text-[11px] md:text-[12px] text-text-light">ERGEBNIS</span>
            <div class="flex flex-col gap-24">
              <h3 class="font-heading font-medium text-[22px] md:text-[28px] text-text-900 leading-snug tracking-[-0.28px]">Eine vollständige, funktionsfähige Buchungsstrecke – responsive, mit echten Fehlerzuständen und konsistenten Design-Tokens.</h3>
              <p class="font-body text-[16px] leading-26 text-text-light">Das Ergebnis basiert auf einer realen Persona, systematischer Analyse und einem Usability-Test mit 6 Probanden und 100% Erfolgsrate. Durchschnittliche Durchlaufzeit: 1:46 Min.</p>
            </div>
          </div>
          <div class="flex gap-16 md:gap-32 items-center flex-wrap">
            <Button label="Live Demo ansehen" href="https://pixelninja0.github.io/waermecheck-buchung/" variant="primary" />
            <Button label="Projekt Details ansehen" href="#" variant="secondary" />
            <Button label="GitHub Repository" href="https://github.com/PixelNinja0" variant="secondary" />
          </div>
        </div>
      </section>

    </main>
  </div>

  <script>
    const sideLinks = document.querySelectorAll<HTMLAnchorElement>('.side-nav-link');
    const sections = document.querySelectorAll<HTMLElement>('section[id]');

    function setSideActive(id: string) {
      sideLinks.forEach((link) => {
        const isActive = link.dataset.section === id;
        const bar = link.querySelector<HTMLElement>('[data-bar]');
        const text = link.querySelector<HTMLElement>('[data-text]');
        if (bar) {
          bar.classList.toggle('w-20', isActive);
          bar.classList.toggle('w-4', !isActive);
          bar.classList.toggle('bg-primary-600', isActive);
          bar.classList.toggle('bg-text-light', !isActive);
        }
        if (text) {
          text.classList.toggle('font-semibold', isActive);
          text.classList.toggle('font-normal', !isActive);
          text.classList.toggle('text-primary-600', isActive);
          text.classList.toggle('text-text-light', !isActive);
        }
      });
    }

    if (sections.length > 0 && sideLinks.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) setSideActive((entry.target as HTMLElement).id);
          });
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
      );
      sections.forEach((s) => observer.observe(s));
      setSideActive('ueberblick');
    }

    // System comparison slider
    const systemSlides = document.querySelectorAll<HTMLElement>('.system-slide');
    const systemSlideNext = document.getElementById('system-slide-next');
    const systemSlidePrev = document.getElementById('system-slide-prev');
    const systemSlideCounter = document.getElementById('system-slide-counter');
    let currentSystemSlide = 0;

    function showSystemSlide(i: number) {
      systemSlides.forEach((el, idx) => { el.hidden = idx !== i; });
      if (systemSlideCounter) systemSlideCounter.textContent = `${i + 1} / ${systemSlides.length}`;
    }

    systemSlideNext?.addEventListener('click', () => {
      currentSystemSlide = (currentSystemSlide + 1) % systemSlides.length;
      showSystemSlide(currentSystemSlide);
    });

    systemSlidePrev?.addEventListener('click', () => {
      currentSystemSlide = (currentSystemSlide - 1 + systemSlides.length) % systemSlides.length;
      showSystemSlide(currentSystemSlide);
    });
  </script>
</Layout>
